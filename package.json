{
  "name": "@qiz42144-web/dsh-token-usage",
  "version": "1.0.0",
  "description": "A lightweight DSH plugin for tracking and visualizing AI token usage: per provider, account, plan and model, with time ranges, trends, a yearly heatmap and a request log. Never calls a model.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE",
    "TEST-REPORT.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "token-tracking",
    "ai-usage",
    "usage-analytics",
    "dashboard",
    "data-visualization",
    "tokens",
    "usage",
    "statistics"
  ],
  "license": "MIT",
  "author": "qiz42144-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiz42144-web/dsh-token-usage.git"
  },
  "homepage": "https://github.com/qiz42144-web/dsh-token-usage#readme",
  "bugs": {
    "url": "https://github.com/qiz42144-web/dsh-token-usage/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
